{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "neverConnectToCloud": true,
  "analytics": false,
  "tui": {
    "autoExit": true
  },
  "namedInputs": {
    "default": [
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/package.json",
      "{projectRoot}/package.json",
      { "env": "NODE_ENV" }
    ],
    "typescript": [
      "{workspaceRoot}/config/rolldown.mjs",
      "{workspaceRoot}/tsconfig*.json",
      "{workspaceRoot}/config/typescript/*.json",
      "{projectRoot}/tsconfig*.json",
      "{projectRoot}/build.mjs",
      "{projectRoot}/tsdown.config.ts",
      "{projectRoot}/src/**/*.{ts,tsx,js,jsx}"
    ],
    "stylesheets": ["{projectRoot}/**/*.{scss,css}"],
    "eslint": [
      "{projectRoot}/eslint.config.mjs",
      "{workspaceRoot}/config/eslint.mjs",
      "{workspaceRoot}/config/eslint-rules/*.mjs"
    ],
    "oxlint": ["{workspaceRoot}/config/oxlint.json", "{projectRoot}/.oxlintrc.json"],
    "vortex-api": [
      "{workspaceRoot}/scripts/extensions-rolldown.mjs",
      { "dependentTasksOutputFiles": "packages/vortex-api/lib/api.d.ts" }
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "default",
        "typescript",
        "!{projectRoot}/src/**/*.test.{ts,tsx}",
        { "dependentTasksOutputFiles": "**/dist/**" }
      ],
      "outputs": ["{projectRoot}/dist/"]
    },
    "test*": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "typescript"],
      "outputs": ["{projectRoot}/tsconfig*.tsbuildinfo"]
    },
    "lint*": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "typescript", "eslint", "oxlint"],
      "outputs": ["{projectRoot}/.lint-results.json"]
    }
  }
}
