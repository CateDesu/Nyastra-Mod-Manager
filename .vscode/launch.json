{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Debug Electron",
      "configurations": ["Debug Main Process", "Debug Renderer Process"],
      "presentation": {
        "hidden": false,
        "group": "",
        "order": 1
      },
      "stopAll": true
    },
    {
      "name": "Debug Electron (System Electron)",
      "configurations": ["Debug Main Process (System Electron)", "Debug Renderer Process"],
      "presentation": {
        "hidden": false,
        "group": "",
        "order": 1
      },
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Debug Main Process",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceRoot}/src/main/node_modules/.bin/electron",
      "runtimeArgs": [".", "--remote-debugging-port=9222"],
      "cwd": "${workspaceRoot}/src/main",
      "env": {
        "NODE_ENV": "development",
        "START_DEVTOOLS": "true"
      },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/src/main/build/**/*.{js,cjs}"],
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "autoAttachChildProcesses": false,
      "timeout": 60000,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    },
    {
      "name": "Debug Main Process (System Electron)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "electron",
      "args": ["."],
      "runtimeArgs": ["--inspect=9229", "--remote-debugging-port=9222"],
      "attachSimplePort": 9229,
      "cwd": "${workspaceRoot}/src/main",
      "env": {
        "NODE_ENV": "development",
        "START_DEVTOOLS": "true"
      },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/src/main/build/**/*.{js,cjs}"],
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "timeout": 60000,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    },
    {
      "name": "Debug Renderer Process",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "timeout": 60000,
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/src/main/build/**/*.{js,cjs}"],
      "sourceMapPathOverrides": {
        "webpack://@vortex/renderer/./*": "${workspaceFolder}/src/renderer/*",
        "webpack://@vortex/renderer/*": "${workspaceFolder}/src/renderer/*"
      },
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceRoot}/node_modules/**",
        "${workspaceRoot}/dist-electron/**"
      ]
    }
  ]
}
