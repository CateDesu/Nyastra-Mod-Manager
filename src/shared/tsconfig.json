{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "extends": "../../config/typescript/strict.json",
  "include": [
    "./src/**/*",
    "../../typings.custom/promise.d.ts",
    "../../typings.custom/web-globals.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": [],
    "allowJs": false,
    "isolatedDeclarations": true
  }
}
