{
  "$schema": "https://github.com/electron-userland/electron-builder/raw/refs/tags/v24.13.3/packages/app-builder-lib/scheme.json",
  "appId": "io.github.CateDesu.NyastraModManager",
  "includeSubNodeModules": false,
  "directories": {
    "buildResources": "../../../assets/images",
    "app": "./build",
    "output": "../../../dist"
  },
  "linux": {
    "executableName": "nyastra-mod-manager",
    "target": ["zip", "AppImage", "deb"],
    "artifactName": "nyastra-${version}-linux-${arch}.${ext}",
    "icon": "../../../assets/images/nyastra.png",
    "category": "Game",
    "synopsis": "Mod Manager",
    "description": "Nyastra's Mod Manager for Linux. Based on Vortex.",
    "maintainer": "CateDesu <205492565+CateDesu@users.noreply.github.com>",
    "mimeTypes": ["x-scheme-handler/nxm"],
    "extraFiles": [
      {
        "from": "../../../assets/images/nyastra.png",
        "to": "nyastra.png"
      },
      {
        "from": "../../../scripts/install-linux.mjs",
        "to": "install-linux.mjs"
      },
      {
        "from": "../../../scripts/import-linux-profile.mjs",
        "to": "import-linux-profile.mjs"
      },
      {
        "from": "../../../scripts/install-linux.sh",
        "to": "install.sh"
      },
      {
        "from": "../../../scripts/linux-README.txt",
        "to": "README.txt"
      },
      {
        "from": "../../../linux/extension-adaptations",
        "to": "linux-extensions",
        "filter": ["apply.mjs", "adapt.mjs", "runtime.cjs", "manifest.json", "NOTICE.txt"]
      },
      {
        "from": "../../../NOTICE.md",
        "to": "NOTICE.md"
      },
      {
        "from": "../../../LICENSE.md",
        "to": "LICENSE.md"
      },
      {
        "from": "../../../etc/Dependency Report.md",
        "to": "Dependency Report.md"
      }
    ],
    "desktop": {
      "Name": "Nyastra's Mod Manager",
      "StartupWMClass": "nyastra-mod-manager"
    },
    "executableArgs": ["--disable-dev-shm-usage"]
  },
  "extraResources": [
    {
      "from": "../../../locales",
      "to": "locales"
    }
  ],
  "files": [
    "**/*",
    "!node_modules/@nexusmods/fomod-installer-native/prebuilds/**",
    "!node_modules/@nexusmods/fomod-installer-native/bin/**",
    "!node_modules/@nexusmods/fomod-installer-native/src-native/**",
    "!node_modules/@nexusmods/fomod-installer-native/*.{h,lib,dll}",
    "!node_modules/@nexusmods/fomod-installer-native/build/*.{vcxproj,filters}",
    "!node_modules/@nexusmods/fomod-installer-native/build/Release/*.{exp,iobj,ipdb,lib,pdb}",
    "!node_modules/@nexusmods/fomod-installer-native/build/Release/obj/**"
  ],
  "asar": true,
  "asarUnpack": [
    "LICENSE.md",
    "bundledPlugins",
    "node_modules/7z-bin",
    "node_modules/bootstrap-sass/assets/stylesheets",
    "node_modules/json-socket",
    "node_modules/react-select/scss",
    "assets/dotnetprobe*",
    "assets/loot/**",
    "assets/css/**",
    "**/*.node",
    "**/*.so",
    "duckdb-extensions"
  ],
  "buildDependenciesFromSource": false,
  "npmRebuild": false,
  "deb": {
    "desktop": {
      "Icon": "/opt/Nyastra's Mod Manager/nyastra.png",
      "StartupWMClass": "nyastra-mod-manager"
    },
    "depends": [
      "libgtk-3-0",
      "libnss3",
      "libxss1",
      "libxtst6",
      "libgbm1",
      "xdg-utils",
      "desktop-file-utils",
      "util-linux",
      "psmisc"
    ]
  }
}
